# ===== 数据库（MySQL）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=winwin

# ===== 服务 =====
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO
JWT_SECRET=please_generate_a_long_random_secret

# ===== xtquant（实盘交易，留空则仅仿真模式）=====
XTACCOUNT=              # 券商资金账号
XTDATA_PATH=            # xtdata 数据目录
XTTRADER_PATH=          # 交易终端 userdata 目录，如 C:\申万宏源策略量化交易终端\userdata_mini

# ===== LLM（AI 助手）=====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.6-plus
LLM_SMALL_MODEL=qwen3-flash
LLM_API_MODE=chat

# ===== 阿里云 OSS（图片上传，可不配置）=====
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_REGION=cn-beijing
OSS_BUCKET=
OSS_BASE_URL=

# ===== 知识库（PostgreSQL，可选）=====
KB_DB_HOST=127.0.0.1
KB_DB_PORT=6432
KB_DB_USER=kbquant_readonly
KB_DB_PASSWORD=
KB_DB_NAME=quant_kb

# Elasticsearch（可选）
ES_URL=http://127.0.0.1:9200

# Embedding（SiliconFlow，可选）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIMENSION=1536
